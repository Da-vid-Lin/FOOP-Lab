# Top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Indentation
indent_style = space
indent_size = 4

# === Java files ===
[*.java]
indent_style = space
indent_size = 4

# === Kotlin files (if you add later) ===
[*.kt]
indent_style = space
indent_size = 4

# === Gradle build scripts ===
[*.gradle]
indent_style = space
indent_size = 4

[*.gradle.kts]
indent_style = space
indent_size = 4

# === Markdown ===
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false  # keep trailing spaces for line breaks

# === YAML / JSON ===
[*.yml]
indent_style = space
indent_size = 2

[*.yaml]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

# === Shell scripts ===
[*.sh]
end_of_line = lf
indent_style = space
indent_size = 2

# === Windows batch files ===
[*.bat]
end_of_line = crlf
indent_style = tab
